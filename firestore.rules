rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Helper for validation logic to avoid shadows
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'points', 'badges']) 
        && data.uid == request.auth.uid 
        && data.points is int 
        && data.badges is list;
    }

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if false; // Profiles are private for listing
      allow create: if isOwner(userId) && isValidUserProfile(request.resource.data);
      allow update: if isOwner(userId) 
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['points', 'badges', 'lastActive', 'displayName'])
        && request.resource.data.points >= resource.data.points; // Only additive points
    }

    match /posts/{postId} {
      function isValidPost(data) {
        return data.authorId == request.auth.uid 
          && data.title is string && data.title.size() < 200
          && data.content is string && data.content.size() < 2000
          && data.category in ['Crops', 'Health', 'Village', 'Urgent'];
      }

      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidPost(request.resource.data);
      allow update: if isSignedIn() // Basic like/comment increment
        && request.resource.data.diff(resource.data).affectedKeys().hasAny(['likes', 'commentsCount']);
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
    }

    match /schemes/{schemeId} {
      allow read: if isSignedIn();
      allow write: if false; // System only
    }

    match /users/{userId}/records/{recordId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/health_records/{recordId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/livestock_records/{recordId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/journal_entries/{recordId} {
      allow read, write: if isOwner(userId);
    }

    match /rental_listings/{listingId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /activities/{activityId} {
      function isValidActivity(data) {
        return data.uid == request.auth.uid
          && data.type is string && data.type.size() <= 100
          && data.timestamp is timestamp && data.timestamp <= request.time;
      }
      allow create: if isSignedIn() && isValidActivity(request.resource.data);
      allow read, update, delete: if false;
    }
  }
}
